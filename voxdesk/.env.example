# Cloud: set PROVIDER=openai and add your own API key. ChatGPT subscriptions do not supply API credits.
PROVIDER=local
OPENAI_API_KEY=
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
DATABASE_URL=sqlite+aiosqlite:///./voxdesk.db
REDIS_URL=
# Docker development only; replace this value for production.
POSTGRES_PASSWORD=voxdesk_dev_only
CHAT_MODEL=gpt-4.1-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_URL=http://localhost:11434
LOCAL_CHAT_MODEL=qwen2.5:3b
LOCAL_EMBEDDING_MODEL=nomic-embed-text
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
PROVIDER_TIMEOUT=90
TURN_TIMEOUT=240
REQUESTS_PER_MINUTE=30
