# Default mode is functional without paid services.
CLEARCV_PROVIDER=local
CLEARCV_DATABASE_URL=sqlite:///./data/clearcv.db
CLEARCV_RETENTION_HOURS=24
# Set to a random value of >=24 characters for a shared deployment.
CLEARCV_API_KEY=
# OpenAI mode: set provider=openai and the real API key below. Never commit .env.
CLEARCV_OPENAI_API_KEY=
CLEARCV_OPENAI_MODEL=gpt-4.1-mini
# Compose defaults to a local-only database password; replace for shared deployment.
POSTGRES_PASSWORD=clearcv-local-only
